FROM python:3.12-slim

ARG UID=1000
ARG GID=1000

# Create a group and user to run the application
RUN groupadd -o -g ${GID} app && \
    useradd -m -o -u ${UID} -g app app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Fix ownership
RUN chown -R app:app /app

# Switch user BEFORE installing dependencies
USER app

# Copy entrypoint
COPY --chown=app:app scripts/entrypoint.sh /app/scripts/entrypoint.sh
RUN chmod +x /app/scripts/entrypoint.sh

ENTRYPOINT ["/app/scripts/entrypoint.sh"]

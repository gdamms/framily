# Env file for the demo stack (config/compose/docker-compose.demo.yml), which pulls
# the published ghcr.io/gdamms/framily image instead of building from source.
# Copy to config/env/.env.demo and fill in real secrets before use -
# even for a quick trial, don't leave the placeholder secrets below in place if the
# frame will be reachable beyond your own machine.

# Public API/backend bind port
APP_PORT=8000

# Backend metadata
TITLE=Framily Backend

# Image tag to pull from ghcr.io/gdamms/framily, e.g. 1.2.0. "latest" tracks the newest release.
VERSION=latest

# Security
SECRET_KEY=replace-with-a-long-random-secret
# Browser access to the bundled web app is same-origin (SERVE_FRONTEND is
# hardcoded true in docker-compose.demo.yml) and doesn't need CORS at all.
# This only matters for cross-origin clients - in particular the Capacitor
# mobile app (https://localhost on Android, capacitor://localhost on iOS).
CORS_ORIGINS=https://localhost,capacitor://localhost

# Runtime tuning
BACKEND_WORKERS=2

# PostgreSQL
POSTGRES_USER=framily
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=framily

# S3 (Garage) - not exposed to the host, reached over the internal compose network
S3_ENDPOINT=garage:3900
S3_ACCESS_KEY=framily
S3_SECRET_KEY=replace-with-strong-storage-password
S3_BUCKET=framily
S3_REGION=garage
S3_SECURE=false

# Frontend
FRONTEND_PORT=5173
ALLOWED_HOST=localhost

# Backend
BACKEND_PORT=8000
TITLE=Framily Backend
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=development
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=/app/frontend-build
BACKEND_WORKERS=2

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=framily

# S3 (Garage)
S3_PORT=3900
S3_ENDPOINT=garage:3900
S3_ACCESS_KEY=garageadmin12345
S3_SECRET_KEY=garageadmin12345
S3_BUCKET=framily
S3_REGION=garage
S3_SECURE=false

# SMTP (outgoing mail) - enables "Forgot password?" on the login page.
# Leave SMTP_HOST empty to disable password reset.
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Public URL of the web app, used for the link in password reset emails
# (defaults to the first CORS_ORIGINS entry).
PUBLIC_URL=http://localhost:5173

# CORS
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/framily

# Frontend API
VITE_API_URL=http://localhost:8000/api/v1

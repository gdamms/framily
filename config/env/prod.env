# Public API/backend bind port
APP_PORT=8000

# Backend metadata
TITLE=Framily Backend

# Image tag to pull from ghcr.io/gdamms/framily (also reported by the API as its version).
# Pin this to a release, e.g. 1.2.0, for reproducible deploys. "latest" tracks the newest release.
VERSION=latest

# Security
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://framily.example.com

# Runtime tuning
BACKEND_WORKERS=2

# PostgreSQL
POSTGRES_USER=framily
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=framily

# S3 (Garage) - not exposed to the host, reached over the internal compose network
S3_ENDPOINT=garage:3900
S3_ACCESS_KEY=framily
S3_SECRET_KEY=replace-with-strong-storage-password
S3_BUCKET=framily
S3_REGION=garage
S3_SECURE=false

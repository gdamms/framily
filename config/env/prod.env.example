# Public API/backend bind port
APP_PORT=8000

# Backend metadata
TITLE=Framily Backend
VERSION=1.0.0

# Security
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://framily.example.com

# Runtime tuning
BACKEND_WORKERS=2

# PostgreSQL
POSTGRES_USER=framily
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=framily

# MinIO
MINIO_ACCESS_KEY=framily
MINIO_SECRET_KEY=replace-with-strong-minio-password
MINIO_BUCKET=framily
MINIO_SECURE=false

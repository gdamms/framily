# Frontend
FRONTEND_PORT=5173

# Backend
BACKEND_PORT=8000
TITLE=Framily Backend
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=development
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=/app/frontend-build
BACKEND_WORKERS=2

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=framily

# MinIO
MINIO_PORT=9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=framily
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false

# CORS
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/framily

# Frontend API
VITE_API_URL=http://localhost:8000/api/v1

# User configuration (set automatically during setup)

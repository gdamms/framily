[Unit]
Description=Framily BLE provisioning service
After=bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/framily
EnvironmentFile=/opt/framily/config.env
ExecStart=/usr/bin/python3 -m ble.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

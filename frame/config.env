FRAMILY_OPT=/opt/framily
FRAMILY_ENV=/opt/framily/config.env

FRAMILY_WIFI=framily-wifi
FRAMILY_HOTSPOT=framily-hotspot
FRAMILY_IFACE=wlan0

FRAMILY_WIFI_SSID=NOTHING_TO_SEE_HERE
FRAMILY_WIFI_PASSWORD=NOTHING_TO_SEE_HERE
FRAMILY_HOTSPOT_SSID=Framily
FRAMILY_HOTSPOT_PASSWORD=raspberry

FRAMILY_DISPATCHER_SRC=/opt/framily/dispatcher/framily.py
FRAMILY_DISPATCHER_DEST=/etc/NetworkManager/dispatcher.d/framily.py

FRAMILY_EPD_SRC=/opt/framily/epd/framily-epd.service
FRAMILY_EPD_DEST=/etc/systemd/system/framily-epd.service

FRAMILY_WEB_SRC=/opt/framily/web/framily-web.service
FRAMILY_WEB_DEST=/etc/systemd/system/framily-web.service

FRAMILY_AGENT_SRC=/opt/framily/agent/framily-agent.service
FRAMILY_AGENT_DEST=/etc/systemd/system/framily-agent.service

FRAMILY_WEB_ADDRESS=0.0.0.0
FRAMILY_WEB_PORT=80

FRAMILY_CONFIG_PATH=/opt/framily/config.json
FRAMILY_TEMPLATE_FOLDER=/opt/framily/web/templates

FRAMILY_EPD_INFO_PATH=/opt/framily/epd/epd_info.json
FRAMILY_EPD_IMAGE_PATH=/opt/framily/epd/epd_img.png

FRAMILY_DOMAIN=framily.lan
FRAMILY_DNSMASQ_PATH=/etc/NetworkManager/dnsmasq-shared.d/framily.conf

FRAMILY_LOG_PATH=/opt/framily/framily.log
